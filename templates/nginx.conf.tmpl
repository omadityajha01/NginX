{{GENERATED_NOTE}}
#
# Global NGINX settings: workers, logging, compression, rate limits, cache.
# Site-specific settings (upstream, HTTPS, proxy) live in conf.d/site.conf.

user  nginx;
worker_processes  auto;            # one worker per CPU core
worker_rlimit_nofile 65535;        # allow many open files/sockets per worker

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 4096;       # max simultaneous connections per worker
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;             # hide NGINX version in headers and error pages

    # ---- Logging: includes timings, which backend answered, and cache status ----
    log_format main_timed '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                          'rt=$request_time urt=$upstream_response_time '
                          'upstream=$upstream_addr ustatus=$upstream_status '
                          'cache=$upstream_cache_status';
    access_log /var/log/nginx/access.log main_timed;

    # ---- Performance ----
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    client_max_body_size 10m;      # max upload size

    # ---- Compression ----
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml
               application/rss+xml image/svg+xml;

    # ---- Rate limiting: 10 requests/second per client IP (burst set per location) ----
    limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;
    limit_req_status 429;

    # ---- Proxy cache: 1 GB on disk, entries dropped after 60 min without use ----
    # Without proxy_cache_valid, NGINX only caches responses whose backend sends
    # Cache-Control / Expires headers, so the app decides what is cacheable.
    proxy_cache_path /var/cache/nginx/app levels=1:2 keys_zone=app_cache:10m
                     max_size=1g inactive=60m use_temp_path=off;

    # Never cache requests from logged-in users (cookie or auth header present).
    map "$http_cookie$http_authorization" $skip_cache {
        ""      0;
        default 1;
    }

    # WebSocket support: send "Connection: upgrade" only when the client asks for it;
    # otherwise send an empty Connection header so upstream keepalive works.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      "";
    }

    include /etc/nginx/conf.d/*.conf;
}
